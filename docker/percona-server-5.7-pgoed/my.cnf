# Minimal config aligned with Percona Server RPM layout.

[mysqld]
# The tarball layout keeps 5.7 plugins under lib/mysql/plugin while the
# compiled-in default points at the build-time prefix; pin it explicitly.
plugin_dir=/usr/local/percona-server/lib/mysql/plugin
# The CentOS 7 build embeds /usr/local/mysql as its installation prefix.
lc-messages-dir=/usr/local/percona-server/share
datadir=/var/lib/mysql
socket=/var/lib/mysql/mysql.sock
# The X Plugin is optional in 5.7; the loose- prefix keeps mysqld happy when
# the plugin is not installed.
loose-mysqlx_socket=/var/lib/mysql/mysqlx.sock
pid-file=/var/run/mysqld/mysqld.pid

!includedir /etc/my.cnf.d

[client]
socket=/var/lib/mysql/mysql.sock
